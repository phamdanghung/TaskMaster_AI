{
  "version": 2,
  "rewrites": [
    { "source": "/api/daily-summary", "destination": "/api/daily-summary.js" },
    { "source": "/api/reminders", "destination": "/api/reminders.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/daily-summary",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
